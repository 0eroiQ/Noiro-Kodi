FROM debian:11

ARG RUST_VERSION=1.91.1
ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    PATH=/opt/cargo/bin:${PATH} \
    CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABIHF_LINKER=arm-linux-gnueabihf-gcc \
    CC_armv7_unknown_linux_gnueabihf=arm-linux-gnueabihf-gcc

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gcc libc6-dev gcc-arm-linux-gnueabihf libc6-dev-armhf-cross git pkg-config python3 \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain ${RUST_VERSION} \
    && rustup target add armv7-unknown-linux-gnueabihf

WORKDIR /src/native/noiro-engine
COPY native/noiro-engine /src/native/noiro-engine
COPY native/stremiox-core /src/native/stremiox-core
RUN cargo build --release --locked --target armv7-unknown-linux-gnueabihf

CMD ["/bin/true"]
