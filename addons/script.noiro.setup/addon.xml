<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.noiro.setup" name="Noiro Setup &amp; Maintenance" version="0.3.0" provider-name="Noiro">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="script.module.noiro" version="0.3.0"/>
    <import addon="script.service.noiro" version="0.3.0"/>
    <import addon="plugin.video.noiro" version="0.3.0"/>
    <import addon="skin.noiro" version="0.3.0"/>
    <import addon="script.noiro.return" version="0.3.0"/>
  </requires>
  <extension point="xbmc.python.script" library="addon.py"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Set up profiles or return between Noiro and OSMC</summary>
    <description lang="en_GB">Creates Stremio-linked Noiro profiles, opens maintenance mode and safely returns to Noiro.</description>
    <platform>linux</platform>
    <license>GPL-3.0-only</license>
    <source>https://github.com/0eroiQ/Noiro-Kodi</source>
  </extension>
</addon>
