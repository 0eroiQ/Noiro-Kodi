<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.noiro" name="Noiro Repository" version="0.3.1" provider-name="Noiro">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository" name="Noiro Repository">
    <dir minversion="21.0.0">
      <info compressed="false">https://github.com/0eroiQ/Noiro-Kodi/releases/latest/download/addons.xml</info>
      <checksum>https://github.com/0eroiQ/Noiro-Kodi/releases/latest/download/addons.xml.sha256</checksum>
      <datadir zip="true">https://github.com/0eroiQ/Noiro-Kodi/releases/latest/download/</datadir>
      <hashes>sha256</hashes>
    </dir>
  </extension>
  <extension point="xbmc.service" library="service.py" start="startup"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Public, signed update channel for NoiroTV</summary>
    <description lang="en_GB">Bootstraps every signed NoiroTV package automatically. Kodi reads the public release channel directly so repository updates and removal do not depend on the running Noiro service.</description>
    <platform>linux</platform>
    <license>GPL-3.0-only</license>
    <website>https://github.com/0eroiQ/Noiro-Kodi</website>
    <source>https://github.com/0eroiQ/Noiro-Kodi</source>
  </extension>
</addon>
