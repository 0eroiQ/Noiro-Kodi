<?xml version="1.0" encoding="UTF-8"?>
<!-- Lightweight Noiro details. Kodi remains the playback and hardware engine. -->
<window>
	<defaultcontrol always="true">8</defaultcontrol>
	<onload>SetProperty(Noiro.SkinHeartbeat,1,home)</onload>
	<onunload>ClearProperty(Noiro.SkinHeartbeat,home)</onunload>
	<controls>
		<include>NoiroBackground</include>
		<control type="image">
			<left>560</left><top>0</top><width>1360</width><height>1080</height>
			<texture background="true" fallback="DefaultVideo.png">$INFO[ListItem.Art(fanart)]</texture>
			<aspectratio align="right" aligny="center">scale</aspectratio><fadetime>300</fadetime>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>1230</width><height>1080</height>
			<texture colordiffuse="NoiroHeroShade">colors/white.png</texture>
		</control>
		<control type="image">
			<left>0</left><top>870</top><width>1920</width><height>210</height>
			<texture colordiffuse="NoiroChrome">colors/white.png</texture>
		</control>
		<control type="label">
			<left>84</left><top>52</top><width>310</width><height>64</height>
			<font>fontNoiroWordmark</font><textcolor>NoiroText</textcolor><label>NOIRO</label>
		</control>
		<control type="label">
			<right>84</right><top>64</top><width>450</width><height>50</height>
			<align>right</align><font>fontNoiroMeta</font><textcolor>NoiroMuted</textcolor><label>$INFO[System.Time]</label>
		</control>
		<control type="label">
			<left>86</left><top>210</top><width>900</width><height>120</height>
			<font>fontNoiroHero</font><textcolor>NoiroText</textcolor><label>$INFO[ListItem.Title]</label><scroll>false</scroll>
		</control>
		<control type="label">
			<left>90</left><top>342</top><width>900</width><height>45</height>
			<font>fontNoiroMeta</font><textcolor>NoiroAccentBright</textcolor>
			<label>$INFO[ListItem.Year]$INFO[ListItem.Duration,  ·  ]$INFO[ListItem.Genre,  ·  ]$INFO[ListItem.Rating,  ·  ★ ]</label>
		</control>
		<control type="textbox">
			<left>88</left><top>414</top><width>790</width><height>240</height>
			<font>fontNoiroBody</font><textcolor>NoiroTextSecondary</textcolor>
			<label fallback="19055">$INFO[ListItem.Plot]</label><autoscroll>false</autoscroll>
		</control>
		<control type="label">
			<left>90</left><top>675</top><width>790</width><height>40</height>
			<font>fontNoiroEyebrow</font><textcolor>NoiroMuted</textcolor>
			<label>$INFO[ListItem.Studio]$INFO[ListItem.Mpaa,  ·  ]</label>
		</control>
		<!-- Kodi-native IDs: play/resume and trailer, without helper services. -->
		<control type="grouplist" id="5000">
			<left>84</left><top>760</top><width>1040</width><height>96</height>
			<orientation>horizontal</orientation><itemgap>18</itemgap><onup>5000</onup><ondown>5000</ondown>
			<control type="button" id="8">
				<width>330</width><height>82</height><include>NoiroButton</include>
				<label>$VAR[VideoInfoPlayButtonLabelVar]</label><onleft>8</onleft><onright>11</onright>
			</control>
			<control type="button" id="11">
				<width>260</width><height>82</height><include>NoiroButton</include>
				<label>$LOCALIZE[20410]</label><onleft>8</onleft><onright>11</onright>
				<visible>!String.IsEmpty(ListItem.Trailer)</visible>
			</control>
		</control>
		<control type="label">
			<left>88</left><bottom>64</bottom><width>1200</width><height>42</height>
			<font>fontNoiroMeta</font><textcolor>NoiroMuted</textcolor><label>BACK  Return</label>
		</control>
	</controls>
</window>
