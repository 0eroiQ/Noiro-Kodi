<?xml version="1.0" encoding="UTF-8"?>
<!-- Remote-first Noiro playback controls. Kodi remains the playback engine. -->
<window>
	<defaultcontrol always="true">602</defaultcontrol>
	<depth>DepthOSD</depth>
	<controls>
		<control type="button">
			<left>0</left><top>0</top><width>1920</width><height>690</height>
			<texturefocus/><texturenofocus/><onclick>Action(close)</onclick>
		</control>
		<control type="group">
			<left>0</left><bottom>0</bottom><width>1920</width><height>390</height>
			<animation effect="slide" start="0,390" end="0,0" time="220" tween="cubic" easing="out">WindowOpen</animation>
			<animation effect="slide" start="0,0" end="0,390" time="180" tween="cubic" easing="in">WindowClose</animation>
			<control type="image">
				<left>0</left><top>0</top><width>1920</width><height>390</height>
				<texture colordiffuse="NoiroChrome">colors/white.png</texture>
			</control>
			<control type="label">
				<left>84</left><top>44</top><width>1280</width><height>66</height>
				<font>fontNoiroRail</font><textcolor>NoiroText</textcolor><label>$INFO[Player.Title]</label>
			</control>
			<control type="label">
				<right>84</right><top>54</top><width>420</width><height>44</height>
				<align>right</align><font>fontNoiroMeta</font><textcolor>NoiroMuted</textcolor>
				<label>$INFO[Player.Time]  /  $INFO[Player.Duration]</label>
			</control>
			<control type="slider" id="87">
				<left>84</left><top>128</top><width>1752</width><height>24</height>
				<texturesliderbar colordiffuse="NoiroPanel">colors/white.png</texturesliderbar>
				<textureslidernib colordiffuse="NoiroAccent">colors/white.png</textureslidernib>
				<textureslidernibfocus colordiffuse="NoiroAccentBright">colors/white.png</textureslidernibfocus>
				<info>Player.Progress</info><action>seek</action>
				<onup>602</onup><ondown>602</ondown>
			</control>
			<control type="grouplist" id="201">
				<left>84</left><top>202</top><width>1752</width><height>96</height>
				<orientation>horizontal</orientation><align>center</align><itemgap>14</itemgap>
				<onup>87</onup><ondown>201</ondown>
				<control type="button" id="601">
					<width>190</width><include>NoiroButton</include><label>Rewind</label>
					<onclick condition="Player.Paused">PlayerControl(Play)</onclick>
					<onclick condition="!Player.Paused">PlayerControl(Rewind)</onclick>
					<visible>Player.SeekEnabled</visible><onleft>601</onleft><onright>602</onright>
				</control>
				<control type="button" id="602">
					<width>220</width><include>NoiroButton</include>
					<label>$VAR[NoiroPlayPauseLabel]</label><onclick>PlayerControl(Play)</onclick>
					<onleft>601</onleft><onright>603</onright>
				</control>
				<control type="button" id="603">
					<width>160</width><include>NoiroButton</include><label>Stop</label>
					<onclick>PlayerControl(Stop)</onclick><onleft>602</onleft><onright>606</onright>
				</control>
				<control type="button" id="606">
					<width>210</width><include>NoiroButton</include><label>Forward</label>
					<onclick condition="Player.Paused">PlayerControl(Play)</onclick>
					<onclick condition="!Player.Paused">PlayerControl(Forward)</onclick>
					<visible>Player.SeekEnabled</visible><onleft>603</onleft><onright>70046</onright>
				</control>
				<control type="button" id="70046">
					<width>220</width><include>NoiroButton</include><label>Subtitles</label>
					<onclick>ActivateWindow(osdsubtitlesettings)</onclick>
					<onleft>606</onleft><onright>70048</onright>
				</control>
				<control type="button" id="70048">
					<width>210</width><include>NoiroButton</include><label>Audio</label>
					<onclick>ActivateWindow(osdaudiosettings)</onclick>
					<onleft>70046</onleft><onright>70048</onright>
				</control>
			</control>
			<control type="label">
				<left>84</left><bottom>34</bottom><width>1000</width><height>38</height>
				<font>fontNoiroMeta</font><textcolor>NoiroMuted</textcolor><label>BACK  Hide controls</label>
			</control>
		</control>
	</controls>
</window>
