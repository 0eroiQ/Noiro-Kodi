<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="skin.noiro" name="Noiro" version="0.1.2" provider-name="Noiro">
  <requires>
    <import addon="xbmc.gui" version="5.17.0"/>
    <import addon="plugin.video.noiro" version="0.1.2"/>
  </requires>
  <extension point="xbmc.gui.skin" debugging="false">
    <res width="1920" height="1080" aspect="16:9" default="true" folder="1080i"/>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">NoiroTV interface for Kodi 21</summary>
    <description lang="en_GB">A dark, remote-first Noiro shell. Estuary remains available through PIN-protected maintenance mode.</description>
    <platform>linux</platform>
    <license>GPL-3.0-only</license>
    <source>https://github.com/0eroiQ/Noiro-Kodi</source>
  </extension>
</addon>
