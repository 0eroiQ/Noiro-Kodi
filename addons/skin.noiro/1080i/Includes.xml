<?xml version="1.0" encoding="UTF-8"?>
<includes>
  <include name="NoiroBackground">
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="NoiroBackground">white.svg</texture>
    </control>
  </include>
  <include name="NoiroHeader">
    <control type="label">
      <left>90</left><top>55</top><width>550</width><height>90</height>
      <font>font30</font><textcolor>NoiroText</textcolor><label>NOIRO</label>
    </control>
    <control type="label">
      <right>90</right><top>72</top><width>650</width><height>50</height>
      <align>right</align><font>font16</font><textcolor>NoiroMuted</textcolor>
      <label>$INFO[System.Time]  ·  $INFO[Weather.Temperature]</label>
    </control>
  </include>
  <include name="NoiroButton">
    <height>82</height><font>font16</font><textcolor>NoiroText</textcolor>
    <focusedcolor>NoiroText</focusedcolor><texturefocus colordiffuse="NoiroPanelFocus">white.svg</texturefocus>
    <texturenofocus colordiffuse="NoiroPanel">white.svg</texturenofocus>
    <align>left</align><aligny>center</aligny><textoffsetx>28</textoffsetx>
  </include>
  <include name="NoiroPosterItem">
    <control type="image">
      <left>15</left><top>15</top><width>235</width><height>350</height>
      <texture background="true">$INFO[ListItem.Art(poster)]</texture><aspectratio align="center" aligny="center">scale</aspectratio>
    </control>
    <control type="label">
      <left>15</left><top>375</top><width>235</width><height>58</height>
      <font>font12</font><textcolor>NoiroText</textcolor><align>center</align><label>$INFO[ListItem.Label]</label>
    </control>
  </include>
  <include name="NoiroOSDButton">
    <width>210</width><height>82</height><font>font12</font><align>center</align><aligny>center</aligny>
    <textcolor>NoiroText</textcolor><focusedcolor>NoiroText</focusedcolor>
    <texturefocus colordiffuse="NoiroPanelFocus">white.svg</texturefocus>
    <texturenofocus colordiffuse="NoiroPanel">white.svg</texturenofocus>
  </include>
  <include name="KeyboardButton">
    <width>104</width><height>74</height><font>font16</font><align>center</align><aligny>center</aligny>
    <texturefocus colordiffuse="NoiroPanelFocus">white.svg</texturefocus>
    <texturenofocus colordiffuse="NoiroPanel">white.svg</texturenofocus>
  </include>
  <variable name="NoiroPlayPauseLabel">
    <value condition="Player.Paused">Play</value>
    <value>Pause</value>
  </variable>
</includes>
